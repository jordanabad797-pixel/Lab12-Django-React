# Copy to frontend/.env.local (ignored by git).
# Base URL of the Django API. Must match the server started with runserver.
VITE_API_URL=http://127.0.0.1:8000/api
# Token printed by `python manage.py seed_quiz` (QUIZ_TOKEN_HUMANO).
# Required for create and delete; listing works without it.
VITE_API_TOKEN=
